<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Networking against the backend API. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- CALL_PHONE is OPTIONAL and only requested if the user picks the instant-call
         path (ACTION_CALL). The default calling path is ACTION_DIAL, which needs no
         permission at all — see README "Calling: ACTION_DIAL vs ACTION_CALL". -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Best-effort call-state observation (TelephonyManager) — see README for exactly
         how unreliable this is across OEMs/Android versions. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Direct SMS send (DirectSmsSender) — the primary send path, with real SENT/DELIVERED
         carrier status instead of a screenshot. Viable because this app is sideloaded, not
         Play-Store distributed (Play's SMS permissions policy restricts SEND_SMS to default
         SMS-handler apps only for Play-distributed apps). Composer handoff (SmsComposer,
         ACTION_SENDTO) remains as the fallback if this permission is denied. -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- OS-verified SMS evidence: read sent messages from the system SMS database so the
         surveyor has carrier-timestamped proof without a screenshot. The message text,
         recipient, and timestamp are stored in the system SMS inbox/sent box and are
         considered more authoritative than a photo of the screen. Only used after the
         SMS send flow completes to read back the record for the sent message. -->
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- Auto-attach evidence: the phone's own call recorder writes to /MIUI/sound_recorder/call_rec
         (not indexed by MediaStore) so All-files access is needed to find and upload it; screenshots
         are in MediaStore so READ_MEDIA_IMAGES lets the SMS screenshot attach itself. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- Manual voice-note recording (post-call) and the emergency press-and-hold
         audio+video capture. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Automatic GPS geotag on visit/call events. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- The emergency capture foreground service (persistent notification is mandatory
         on Android; this app makes no claim of covert/background capture — see README). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".PmfbyEvidenceApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.PmfbyEvidence"
        android:usesCleartextTraffic="true">

        <!-- usesCleartextTraffic=true: the emulator/LAN dev backend is plain HTTP
             (http://10.0.2.2:4000). See README for switching to HTTPS for a real
             deployment, at which point this should be removed. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PmfbyEvidence">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Appears in the "Open with" chooser alongside Truecaller/Messages when any
             app fires ACTION_DIAL/ACTION_CALL (tel:) or ACTION_SENDTO (smsto:/sms:).
             The activity looks up the number in the local cache and deep-links directly
             to CallScreen or SmsTemplateScreen — zero extra taps for the surveyor. -->
        <activity
            android:name=".PhoneIntentActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <action android:name="android.intent.action.CALL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="smsto" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
            </intent-filter>
        </activity>

        <service
            android:name=".capture.EmergencyCaptureService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>

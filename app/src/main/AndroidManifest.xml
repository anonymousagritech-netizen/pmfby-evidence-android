<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Networking against the backend API. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- CALL_PHONE is OPTIONAL and only requested if the user picks the instant-call
         path (ACTION_CALL). The default calling path is ACTION_DIAL, which needs no
         permission at all — see README "Calling: ACTION_DIAL vs ACTION_CALL". -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Best-effort call-state observation (TelephonyManager) — see README for exactly
         how unreliable this is across OEMs/Android versions. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Direct SMS send (DirectSmsSender) — the primary send path, with real SENT/DELIVERED
         carrier status instead of a screenshot. Viable because this app is sideloaded, not
         Play-Store distributed (Play's SMS permissions policy restricts SEND_SMS to default
         SMS-handler apps only for Play-distributed apps). Composer handoff (SmsComposer,
         ACTION_SENDTO) remains as the fallback if this permission is denied. -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- Manual voice-note recording (post-call) and the emergency press-and-hold
         audio+video capture. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Automatic GPS geotag on visit/call events. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- The emergency capture foreground service (persistent notification is mandatory
         on Android; this app makes no claim of covert/background capture — see README). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".PmfbyEvidenceApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.PmfbyEvidence"
        android:usesCleartextTraffic="true">

        <!-- usesCleartextTraffic=true: the emulator/LAN dev backend is plain HTTP
             (http://10.0.2.2:4000). See README for switching to HTTPS for a real
             deployment, at which point this should be removed. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PmfbyEvidence">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".capture.EmergencyCaptureService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
